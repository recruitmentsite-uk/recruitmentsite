{
  "name": "placeuk",
  "private": true,
  "version": "0.1.0",
  "description": "Automated UK recruitment platform — compete with Reed, Hays, and Indeed without a large ops team",
  "scripts": {
    "dev": "pnpm --filter @placeuk/web dev",
    "build": "pnpm --filter @placeuk/shared build && pnpm --filter @placeuk/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:push": "node scripts/supabase-push-schema.mjs",
    "jobs:sync": "node scripts/sync-job-feeds.mjs",
    "jobs:sync:reed": "node scripts/sync-job-feeds.mjs --reed-only",
    "jobs:enrich": "node scripts/enrich-job-listings.mjs",
    "match:run": "node scripts/run-candidate-matching.mjs",
    "alerts:digest": "node scripts/send-job-alert-digests.mjs",
    "jobs:expire": "node scripts/expire-old-jobs.mjs",
    "jobs:deactivate-seed": "node scripts/deactivate-seed-jobs.mjs",
    "campaign:employers": "node scripts/outreach-employer-campaign.mjs",
    "stripe:setup": "node scripts/setup-stripe-products.mjs",
    "prospects:build": "node scripts/build-employer-prospects.mjs",
    "prospects:enrich": "node scripts/enrich-prospect-emails.mjs",
    "prospects:scrape": "node scripts/scrape-prospect-emails.mjs",
    "prospects:competitors": "node scripts/enrich-competitor-boards.mjs",
    "metrics:weekly": "node scripts/weekly-metrics.mjs",
    "ops:readiness": "node scripts/check-production-readiness.mjs",
    "ops:accounts": "node scripts/go-live-accounts.mjs",
    "ops:cpanel-emails": "node scripts/cpanel-create-emails.mjs",
    "ops:supabase": "node scripts/setup-supabase.mjs",
    "ops:stripe": "node scripts/setup-stripe.mjs",
    "ops:cloudflare": "node scripts/cloudflare-dns-handoff.mjs",
    "ops:vercel": "node scripts/vercel-deploy.mjs",
    "ops:dns": "node scripts/cpanel-update-dns.mjs",
    "ops:go-live": "node scripts/go-live-status.mjs",
    "ops:supabase-auth": "node scripts/supabase-auth-config.mjs",
    "ops:resend": "node scripts/setup-resend-cloudflare.mjs",
    "ops:resend-dns": "node scripts/add-resend-dns-cloudflare.mjs",
    "ops:resend-verify": "node scripts/verify-resend-domain.mjs",
    "ops:smoke": "node scripts/smoke-test-go-live.mjs",
    "test:unit": "node scripts/test-feeds-and-limits.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ops:partner-feeds": "node scripts/submit-partner-feeds.mjs",
    "ops:indexnow": "node scripts/submit-indexnow.mjs",
    "ops:gsc": "node scripts/submit-gsc-priority.mjs",
    "ops:daily-report": "node scripts/daily-ops-report.mjs",
    "ops:weekly-brief": "node scripts/weekly-ops-brief.mjs",
    "ops:cs-triage": "node scripts/cs-triage-and-mark.mjs",
    "ops:cs-check": "node scripts/cs-check-inboxes.mjs",
    "prospects:expand": "node scripts/build-employer-prospects.mjs && node scripts/enrich-prospect-emails.mjs",
    "ops:apply-templates": "node scripts/apply-supabase-email-templates.mjs",
    "ops:verify-admin-emails": "node scripts/verify-admin-emails.mjs",
    "ops:seed-jobs": "node scripts/seed-demo-jobs.mjs",
    "jobs:seed": "node scripts/bulk-seed-jobs.mjs",
    "jobs:polish": "node scripts/polish-job-descriptions.mjs",
    "ops:openai": "node scripts/setup-openai.mjs"
  },
  "devDependencies": {
    "@placeuk/shared": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "mammoth": "^1.12.0",
    "next": "^15.2.3",
    "pg": "^8.22.0",
    "stripe": "^17.7.0",
    "typescript": "^5.8.2",
    "unpdf": "^1.8.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
